# Copy this file to .env and fill in real values.

# SQLAlchemy connection string. Default is a local SQLite file under ./data/.
DATABASE_URL=sqlite:///./data/pib_agent.db

# Logging
LOG_LEVEL=INFO

# Added in M2 (Claude enrichment)
ANTHROPIC_API_KEY=
# Model used for enrichment (summary/context/UPSC questions). Defaults to claude-sonnet-5.
ANTHROPIC_MODEL=claude-sonnet-5

# Added in M6 (Telegram bot)
TELEGRAM_BOT_TOKEN=
# Your own Telegram chat id — receives an alert whenever a pipeline run
# finishes failed or partial_failure. Message the bot, then check
# https://api.telegram.org/bot<TOKEN>/getUpdates for your chat id.
# Leave blank to disable alerting.
TELEGRAM_ADMIN_CHAT_ID=

# Added in M7 (scheduling) — off by default; uncomment to run the pipeline
# automatically inside `pib-agent serve`.
# SCHEDULER_ENABLED=true
# SCHEDULER_INTERVAL_MINUTES=30
# SCHEDULER_START_HOUR_IST=9
# SCHEDULER_END_HOUR_IST=21
# SCHEDULER_TIMEZONE=Asia/Kolkata

# Sign-in (must match the VITE_* ids in frontend/.env.local).
GOOGLE_CLIENT_ID=
TELEGRAM_CLIENT_ID=
# Set to true wherever the site is served over HTTPS.
SESSION_COOKIE_SECURE=false
