# Copy to .env.local (gitignored) to override.
# Relative by default: requests go through Vite's /api proxy so the page and
# API share an origin, which keeps the session cookie first-party and matches
# how production serves them. An absolute URL is still honoured if you need it.
VITE_API_BASE_URL=/api

# Sign-in. Google: Cloud Console -> OAuth 2.0 Client ID (Web), with
# http://localhost:5173 as an authorized JavaScript origin.
# Telegram: BotFather -> your bot -> Login Widget (needs a registered domain).
# Leave a value blank and that sign-in button is hidden.
VITE_GOOGLE_CLIENT_ID=
VITE_TELEGRAM_CLIENT_ID=
