# API base for the SPA. Defaults to /api on the page's own origin, which the
# Vite dev server proxies to the backend — usually leave unset.
# VITE_API_BASE_URL=/api

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Set only for the deployed
# site: unset means analytics no-op entirely, so local development never
# reaches the property. Not a secret — it ships in the page source.
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
